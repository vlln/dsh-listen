{
  "name": "@vlln/dsh-listen",
  "version": "0.1.5",
  "type": "module",
  "description": "Give a text-only agent ears: the listen tool returns transcript, signal images and numeric audio evidence, without passing the question to the model",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["dsh-plugin", "deepseek-harness", "audio", "speech", "tool"],
  "engines": { "node": ">=22", "dsh": "^0.2.1-rc.5" },
  "main": "./src/index.mjs",
  "exports": { ".": "./src/index.mjs", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml", "./locale/*.json": "./locale/*.json" },
  "icon": "./icon.svg",
  "files": ["src", "cordis.patch.yml", "icon.svg", "locale", "LICENSE", "README.md", "docs/evaluation/mmau-*.svg"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test:infra": "node --test test/infra/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:coverage": "node --import ./test/helpers/register-runtime.mjs --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/coverage.mjs --test-reporter-destination=stdout test/unit/*.test.mjs",
    "gate:feature": "npm run check && npm run test:coverage",
    "check": "node scripts/check.mjs",
    "gate": "npm run check && npm run test:infra"
  },
  "dependencies": { "fft.js": "4.0.4", "pngjs": "7.0.0" }
}
